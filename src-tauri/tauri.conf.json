{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resume ATS",
  "version": "0.1.0",
  "identifier": "com.resumeats.app",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../frontend/dist/frontend/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Resume ATS",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/resume-ats-backend"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4RTFGNEY3M0QzRDFFN0MKUldSOEhqMDk5L1RoS0d3VWtzanBWS0lPSU40Z3lSZm0xdUhCUG9rNWlaTktmWk1ZcDVhZjRhaFUK",
      "endpoints": [
        "https://github.com/srinadhmanchikalapudi/resume-ats/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
