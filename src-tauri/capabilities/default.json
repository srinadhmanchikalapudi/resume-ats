{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$LOCALDATA/ResumeATS/**" }, { "path": "$DATA/ResumeATS/**" }]
    }
  ]
}
